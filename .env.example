SLACK_BOT_TOKEN=xoxb-...      # Slack app -> Install App -> Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...      # Basic Information -> App-Level Tokens (connections:write)
# CLAUDE_BIN=/path/to/claude  # only if `claude` is not on PATH
# CLAUDE_MODEL=...            # model override
# ANTHROPIC_API_KEY=sk-ant-...      # if set, llm.js uses the API instead of the CLI
# SF_DOMAIN=... SF_CLIENT_ID=... SF_CLIENT_SECRET=...  # if set, builder.js calls Salesforce
